generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoStatus {
  SCHEDULED
  ACTIVE
  FINISHED
}

model Promotion {
  id              String       @id @default(uuid())
  name            String
  productCategory String
  discountType    DiscountType
  discountValue   Float
  startDate       DateTime
  endDate         DateTime
  status          PromoStatus  @default(SCHEDULED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
